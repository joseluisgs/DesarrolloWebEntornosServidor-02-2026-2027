{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "productos-route": {
        "ClusterId": "productos-cluster",
        "Match": {
          "Path": "/api/productos/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/productos/{**catch-all}" }
        ],
        "AuthorizationPolicy": "authenticated"
      },
      "proveedores-route": {
        "ClusterId": "proveedores-cluster",
        "Match": {
          "Path": "/api/proveedores/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/proveedores/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://auth-microservice:5101"
          }
        }
      },
      "productos-cluster": {
        "Destinations": {
          "productos-destination": {
            "Address": "http://productos-microservice:5102"
          }
        }
      },
      "proveedores-cluster": {
        "Destinations": {
          "proveedores-destination": {
            "Address": "http://proveedores-microservice:5103"
          }
        }
      }
    }
  },
  "Jwt": {
    "Key": "SuperSecretKeyForJwtToken2024!SuperSecretKeyForJwtToken2024!",
    "Issuer": "AuthMicroService",
    "Audience": "ApiGateway",
    "ExpirationMinutes": 60
  }
}
